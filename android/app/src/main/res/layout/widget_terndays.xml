<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 小组件:年份眉题 + 今年 Top 3 城市,三行等权重(同字号、同字重、同颜色)。
  每行内部:城市名 15 + 天数 19 + 单位 11,基线对齐;右缘对齐成一列。
  整块唯一的品牌色是年份;无描边 / 阴影 / 高光,边距 16dp,圆角跟系统。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="12sp"
        android:textColor="@color/widgetAccent" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:text="@string/widget_empty"
        android:textSize="13sp"
        android:textColor="@color/widgetSecondary"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_city_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:id="@+id/widget_days_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="19sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_unit_day"
            android:textSize="11sp"
            android:textColor="@color/widgetSecondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_gap_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_city_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:id="@+id/widget_days_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="19sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_unit_day"
            android:textSize="11sp"
            android:textColor="@color/widgetSecondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_gap_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_city_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:id="@+id/widget_days_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="19sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_unit_day"
            android:textSize="11sp"
            android:textColor="@color/widgetSecondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
