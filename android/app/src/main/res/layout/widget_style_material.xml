<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 小组件 · 系统材质(Android 近似)
  三种外观共用同一套信息层级(年份眉题 + Top 3 城市三行等权重,城市名 15 / 天数 19 / 单位 11),
  只换底面与文字配色。**这三个布局由同一份模板生成,改层级请三个一起改。**
  底面:90% 不透明的中性色——小组件是静态快照,Android 做不出 iOS 那种真模糊,这里是近似。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_material"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="12sp"
        android:textColor="@color/widgetAccent" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:text="@string/widget_empty"
        android:textSize="13sp"
        android:textColor="@color/widgetSecondary"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_city_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:id="@+id/widget_days_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="19sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_unit_day"
            android:textSize="11sp"
            android:textColor="@color/widgetSecondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_gap_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_city_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:id="@+id/widget_days_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="19sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_unit_day"
            android:textSize="11sp"
            android:textColor="@color/widgetSecondary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_gap_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_city_3"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="15sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:id="@+id/widget_days_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:textSize="19sp"
            android:textColor="@color/widgetPrimary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="@string/widget_unit_day"
            android:textSize="11sp"
            android:textColor="@color/widgetSecondary" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
